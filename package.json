  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node -e \"const fs=require('fs'); if(fs.existsSync('out')) fs.cpSync('out', '.out', {recursive:true});\"",
    "start": "next start",
    "desktop:dev": "node desktop-app/scripts/dev.js",
    "desktop:build": "pnpm run build && node desktop-app/scripts/prepare-renderer.js",
    "desktop:package": "pnpm run desktop:build && pnpm --dir desktop-app run package",
    "desktop:package:dir": "pnpm run desktop:build && pnpm --dir desktop-app run package:dir"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@types/three": "^0.186.0",
